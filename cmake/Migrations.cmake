# Embeds migrations/*.sql into a generated C++ source so the binary is
# self-contained (no runtime dependency on the source tree).
#
# File naming: NNNN_description.sql  (NNNN = integer schema version, ascending)

file(GLOB LANSYNC_MIGRATION_FILES CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/migrations/*.sql)
list(SORT LANSYNC_MIGRATION_FILES)

set(LANSYNC_MIGRATIONS_CPP ${CMAKE_BINARY_DIR}/generated/builtin_migrations.cpp)

set(_body "// Generated by cmake/Migrations.cmake. Do not edit.\n")
string(APPEND _body "#include \"storage/database/migrator.hpp\"\n\n")
string(APPEND _body "namespace lansync::storage {\n\n")
string(APPEND _body "std::span<const Migration> builtinMigrations() {\n")
string(APPEND _body "    static const Migration kMigrations[] = {\n")
foreach(_file IN LISTS LANSYNC_MIGRATION_FILES)
    get_filename_component(_name ${_file} NAME_WE)
    string(REGEX MATCH "^([0-9]+)_(.*)$" _m "${_name}")
    if(NOT _m)
        message(FATAL_ERROR "Bad migration file name (want NNNN_name.sql): ${_file}")
    endif()
    set(_vernum ${CMAKE_MATCH_1})
    set(_mname ${CMAKE_MATCH_2})
    string(REGEX REPLACE "^0+([0-9])" "\\1" _vernum "${_vernum}")
    file(READ ${_file} _sql)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_file})
    string(APPEND _body "        {${_vernum}, \"${_mname}\", R\"LANSYNC_SQL(${_sql})LANSYNC_SQL\"},\n")
endforeach()
string(APPEND _body "    };\n    return kMigrations;\n}\n\n} // namespace lansync::storage\n")

file(GENERATE OUTPUT ${LANSYNC_MIGRATIONS_CPP} CONTENT "${_body}")
